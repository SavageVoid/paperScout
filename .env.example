# Copy to .env (`make init` does this and generates the secrets). Never commit .env.

# --- Postgres (warehouse + Airflow metadata) ---
POSTGRES_USER=docpulse
POSTGRES_PASSWORD=docpulse
POSTGRES_PORT=5432

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_FERNET_KEY=generated-by-make-init
AIRFLOW_SECRET_KEY=generated-by-make-init

# --- Object store (S3 API) ---
# Local SeaweedFS accepts any credentials unless you configure auth. For AWS S3: remove
# S3_ENDPOINT_URL override in docker-compose.yml, set real keys, real bucket and region.
S3_BUCKET=docpulse
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=docpulse
AWS_SECRET_ACCESS_KEY=docpulse-local-secret
# Pin this after your first successful pull, e.g. chrislusf/seaweedfs:<version>
OBJECTSTORE_IMAGE=chrislusf/seaweedfs:latest

# --- arXiv ingestion ---
# REQUIRED in spirit: arXiv asks API clients to identify themselves.
ARXIV_CONTACT_EMAIL=you@example.com
ARXIV_CATEGORIES=cs.LG,cs.CL,cs.AI
ARXIV_PAGE_SIZE=200
# The terms say one request per 3 s. Values below 3.0 are rejected at startup.
ARXIV_MIN_INTERVAL_S=3.1
ARXIV_MAX_PAGES=100
ARXIV_LOOKBACK_HOURS=144
